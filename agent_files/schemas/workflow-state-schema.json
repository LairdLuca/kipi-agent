{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kipi Workflow State Schema",
  "description": "State tracking file for Kipi workflow resumability",
  "type": "object",
  "required": ["workflow_version", "workflow_type", "timestamps", "completed_steps", "current_step"],
  "properties": {
    "workflow_version": {
      "type": "string",
      "description": "Version of Kipi workflow schema",
      "example": "1.0.0"
    },
    "workflow_type": {
      "type": "string",
      "enum": ["repository-initialize", "code-scan-document", "process-user-data", "update-core-knowledge", "cleanup-knowledge"],
      "description": "Which Kipi workflow is being executed"
    },
    "timestamps": {
      "type": "object",
      "required": ["started", "last_updated"],
      "properties": {
        "started": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when workflow started"
        },
        "last_updated": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of last state update"
        },
        "completed": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when workflow completed (if finished)"
        }
      }
    },
    "scan_level": {
      "type": "string",
      "enum": ["quick", "chapter", "exhaustive"],
      "description": "Depth of code scanning (for code-scan-document workflow)"
    },
    "project_root": {
      "type": "string",
      "description": "Absolute path to project root directory"
    },
    "core_knowledge_path": {
      "type": "string",
      "description": "Absolute path to knowledge/core_knowledge folder"
    },
    "completed_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "status", "timestamp"],
        "properties": {
          "step": {
            "type": "string",
            "description": "Step identifier (e.g., 'step_1_scan', 'step_2_propose')"
          },
          "status": {
            "type": "string",
            "enum": ["completed", "partial", "failed", "skipped"]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "outputs": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Files written during this step"
          },
          "summary": {
            "type": "string",
            "description": "1-2 sentence summary of step outcome"
          }
        }
      }
    },
    "current_step": {
      "type": "string",
      "description": "Current step identifier for resumption"
    },
    "findings": {
      "type": "object",
      "description": "High-level summaries only (detailed findings purged after writing)",
      "properties": {
        "repository_analysis": {
          "type": "object",
          "properties": {
            "repository_type": {
              "type": "string",
              "enum": ["monolith", "monorepo", "multi-part"]
            },
            "primary_language": { "type": "string" },
            "framework": { "type": "string" },
            "total_files": { "type": "integer" },
            "total_loc": { "type": "integer" }
          }
        },
        "structure_proposal": {
          "type": "object",
          "properties": {
            "proposed_chapters": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "priority": { "type": "integer" }
                }
              }
            },
            "user_approved": { "type": "boolean" },
            "approval_timestamp": { "type": "string", "format": "date-time" }
          }
        },
        "chapters_progress": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "chapter_name": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["not_started", "in_progress", "written", "validated"]
              },
              "file_path": { "type": "string" },
              "sub_chapters_count": { "type": "integer" },
              "summary": { "type": "string" }
            }
          }
        },
        "batches_completed": {
          "type": "array",
          "description": "For deep/exhaustive scans: subfolders processed",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "files_scanned": { "type": "integer" },
              "summary": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "outputs_generated": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of all output files generated"
    },
    "resume_instructions": {
      "type": "string",
      "description": "Human-readable instructions for resuming from current_step"
    },
    "user_data_processing": {
      "type": "object",
      "description": "State specific to process-user-data workflow",
      "properties": {
        "files_to_process": {
          "type": "array",
          "items": { "type": "string" }
        },
        "files_processed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "original_path": { "type": "string" },
              "content_type": { "type": "string" },
              "output_path": { "type": "string" },
              "archive_path": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          }
        },
        "files_failed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "error": { "type": "string" }
            }
          }
        }
      }
    },
    "validation_status": {
      "type": "object",
      "properties": {
        "last_validated": {
          "type": "string",
          "format": "date-time"
        },
        "checklist_items_passed": { "type": "integer" },
        "checklist_items_total": { "type": "integer" },
        "validation_errors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "context_management": {
      "type": "object",
      "description": "Tracks what's in memory vs purged",
      "properties": {
        "summaries_in_memory": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of summary keys currently held in context"
        },
        "last_purge_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "purged_items_count": { "type": "integer" }
      }
    }
  }
}

